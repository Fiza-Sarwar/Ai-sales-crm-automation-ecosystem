      "parameters": {
        "jsCode": "// Get lead data directly from the input stream\nconst lead = { ...$input.first().json };\n\n// Read ALL rows from Intern Contact sheet (call_outcomes)\nlet interns = [];\ntry {\n  interns = $items(\"Google Sheets (Lookup Intern Contact)\");\n} catch (e) {\n  interns = [];\n}\n\n// Match the correct intern case-insensitively\nconst assignedToName = String(lead.assigned_to).trim().toLowerCase();\nconst matchedIntern = interns.find(i => \n  i.json && \n  i.json[\"Intern name\"] && \n  String(i.json[\"Intern name\"]).trim().toLowerCase() === assignedToName\n);\n\nconst internContact = matchedIntern ? matchedIntern.json : {};\n\nlead.intern_whatsapp = internContact.PhoneNumbers || '923000000000';\nlead.intern_email    = internContact.Email || '';\n\n// Read ALL rows from Messaging Log\nlet history = [];\ntry {\n  history = $items(\"Google Sheets (Lookup History)\");\n} catch (e) {\n  history = [];\n}\n\n// Read dynamic wait periods from Configuration Module sheet\nlet waitPeriodMsg2 = 3; // Default fallback\nlet waitPeriodMsg3 = 4; // Default fallback\ntry {\n  const configRow = $node[\"Google Sheets (Read Config)\"].json || {};\n  waitPeriodMsg2 = parseInt(configRow.wait_period_msg2_days) || 3;\n  waitPeriodMsg3 = parseInt(configRow.wait_period_msg3_days) || 4;\n} catch (e) {\n  // If config read fails, default to spec standards (3 and 4 days)\n}\n\n// Filter to only this lead's rows\nconst currentLeadId = String(lead.title).trim().toLowerCase();\n\nconst validLogs = history.filter(h =>\n  h.json &&\n  h.json.message_id &&\n  String(h.json.lead_id).trim().toLowerCase() === currentLeadId\n);\n\nconst sentMessageNumbers = [...new Set(\n  validLogs.map(h => parseInt(h.json.message_number)).filter(n => !isNaN(n))\n)];\n\nconst highestSent = sentMessageNumbers.length > 0 ? Math.max(...sentMessageNumbers) : 0;\n\nlead.next_message_number = 4;\nlead.escalate_action = 'none';\n\nif (highestSent === 0) {\n  lead.next_message_number = 1;\n\n} else if (highestSent === 1) {\n  const logsForMsg1 = validLogs.filter(h => parseInt(h.json.message_number) === 1);\n  logsForMsg1.sort((a, b) => new Date(b.json.sent_at) - new Date(a.json.sent_at));\n  const lastMsg1 = logsForMsg1[0].json;\n  \n  const diffDays = Math.floor((new Date() - new Date(lastMsg1.sent_at)) / (1000 * 60 * 60 * 24));\n  \n  if (diffDays >= waitPeriodMsg2) {\n    const isRead = lastMsg1.read_status && String(lastMsg1.read_status).toLowerCase() !== 'false' && String(lastMsg1.read_status).trim() !== '';\n    const hasReplied = lastMsg1.reply_status && String(lastMsg1.reply_status).toLowerCase() !== 'false' && String(lastMsg1.reply_status).trim() !== '';\n    \n    if (isRead && !hasReplied) {\n      lead.escalate_action = 'Read but no reply';\n    } else if (!isRead && !hasReplied) {\n      lead.next_message_number = 2;\n    }\n  }\n\n} else if (highestSent === 2) {\n  const logsForMsg2 = validLogs.filter(h => parseInt(h.json.message_number) === 2);\n  logsForMsg2.sort((a, b) => new Date(b.json.sent_at) - new Date(a.json.sent_at));\n  const lastMsg2 = logsForMsg2[0].json;\n  \n  const diffDays = Math.floor((new Date() - new Date(lastMsg2.sent_at)) / (1000 * 60 * 60 * 24));\n  \n  if (diffDays >= waitPeriodMsg3) {\n    const hasReplied = lastMsg2.reply_status && String(lastMsg2.reply_status).toLowerCase() !== 'false' && String(lastMsg2.reply_status).trim() !== '';\n    if (!hasReplied) {\n      lead.next_message_number = 3;\n    }\n  }\n\n} else if (highestSent === 3) {\n  const logsForMsg3 = validLogs.filter(h => parseInt(h.json.message_number) === 3);\n  logsForMsg3.sort((a, b) => new Date(b.json.sent_at) - new Date(a.json.sent_at));\n  const lastMsg3 = logsForMsg3[0].json;\n  \n  const diffDays = Math.floor((new Date() - new Date(lastMsg3.sent_at)) / (1000 * 60 * 60 * 24));\n  \n  if (diffDays >= 4) { // 4 days wait after final message\n    const hasReplied = lastMsg3.reply_status && String(lastMsg3.reply_status).toLowerCase() !== 'false' && String(lastMsg3.reply_status).trim() !== '';\n    if (!hasReplied) {\n      // Map directly to your teammate's \"Read but no reply\" branch to trigger the manual task\n      lead.escalate_action = 'Read but no reply'; \n    }\n  }\n}\n\nreturn [{ json: lead }];"
