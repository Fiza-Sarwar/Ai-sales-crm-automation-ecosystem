      "parameters": {
        "jsCode": "const { metrics, rawRows } = $input.first().json;\n\n// Helper\nconst percent = (value, total) =>\n  total > 0 ? Number(((value / total) * 100).toFixed(1)) : 0;\n\nconst metricsRows = metrics.map(row => ({\n  ...row,\n  deliveryRatePct: percent(row.delivered, row.sent),\n  readRatePct: percent(row.read, row.delivered),\n  replyRatePct: percent(row.replied, row.read),\n  failureRatePct: percent(row.failed, row.sent),\n  retryAverage: row.sent > 0 ? Number((row.retry_count / row.sent).toFixed(2)) : 0\n}));\n\nreturn [{\n  json: {\n    metricsRows,\n    rawRows\n  }\n}];"
      },
