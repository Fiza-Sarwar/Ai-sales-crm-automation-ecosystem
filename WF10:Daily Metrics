      "parameters": {
        "jsCode": "const metricsRows = $items('Node 4 - Compute Rates & Avg Response Time')[0].json.metricsRows;\nconst dashboardData = $items('Node 5 - Follow-up Success Rate & Stale Flags')[0].json;\n\nconst escapeHtml = (text = \"\") =>\n  String(text)\n    .replace(/&/g, \"&amp;\")\n    .replace(/</g, \"&lt;\")\n    .replace(/>/g, \"&gt;\")\n    .replace(/\"/g, \"&quot;\")\n    .replace(/'/g, \"&#039;\");\n\nconst channelRows = metricsRows.map(c => `\n<tr>\n  <td>${escapeHtml(c.channel)}</td>\n  <td align=\"center\">${c.sent}</td>\n  <td align=\"center\">${c.delivered}</td>\n  <td align=\"center\">${c.read}</td>\n  <td align=\"center\">${c.replied}</td>\n  <td align=\"center\" style=\"font-weight:bold\">${c.reply_rate.toFixed(1)}%</td>\n</tr>\n`).join(\"\");\n\nconst html = `\n<div style=\"font-family:Arial,sans-serif;font-size:14px;\">\n  <h2 style=\"margin-bottom:15px;\">📊 Messaging Dashboard (Last 7 Days)</h2>\n  <table style=\"width:100%;border-collapse:collapse;border:1px solid #ddd;\">\n    <thead style=\"background:#f3f4f6;\">\n      <tr>\n        <th style=\"padding:8px\">Channel</th>\n        <th>Sent</th>\n        <th>Delivered</th>\n        <th>Read</th>\n        <th>Replied</th>\n        <th>Reply Rate</th>\n      </tr>\n    </thead>\n    <tbody>\n      ${channelRows}\n    </tbody>\n  </table>\n  <br>\n  <div style=\"background:#f8fafc;padding:15px;border:1px solid #ddd;border-radius:6px;\">\n    <p><strong>📨 Total Messages:</strong> ${dashboardData.total_messages}</p>\n    <p><strong>📦 Delivery Rate:</strong> ${dashboardData.delivery_rate}%</p>\n    <p><strong>👀 Read Rate:</strong> ${dashboardData.read_rate}%</p>\n    <p><strong>💬 Reply Rate:</strong> ${dashboardData.reply_rate}%</p>\n  </div>\n</div>\n`;\n\nreturn [{\n  json: {\n    messagingSectionHtml: html\n  }\n}];"
      },
