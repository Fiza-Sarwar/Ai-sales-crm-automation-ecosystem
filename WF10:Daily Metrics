    {
      "parameters": {
        "jsCode": "const { metricsRows = [], rawRows = [] } = $input.first().json;\n\nconst summary = metricsRows.reduce((acc, row) => {\n  acc.totalMessages += row.total_messages || 0;\n  acc.sent += row.sent || 0;\n  acc.delivered += row.delivered || 0;\n  acc.read += row.read || 0;\n  acc.replied += row.replied || 0;\n  acc.failed += row.failed || 0;\n  acc.retryCount += row.retry_count || 0;\n  return acc;\n}, {\n  totalMessages: 0,\n  sent: 0,\n  delivered: 0,\n  read: 0,\n  replied: 0,\n  failed: 0,\n  retryCount: 0\n});\n\nconst deliveryRate = summary.sent ? Number((summary.delivered / summary.sent * 100).toFixed(1)) : 0;\nconst readRate = summary.delivered ? Number((summary.read / summary.delivered * 100).toFixed(1)) : 0;\nconst replyRate = summary.read ? Number((summary.replied / summary.read * 100).toFixed(1)) : 0;\n\n// Friday = 5 for testing, change to 0 for Sunday in production\nconst isWeeklyRun = new Date().getDay() === 5;\n\nreturn [{\n  json: {\n    date: new Date().toISOString().split('T')[0],\n    total_messages: summary.totalMessages,\n    sent: summary.sent,\n    delivered: summary.delivered,\n    read: summary.read,\n    replied: summary.replied,\n    failed: summary.failed,\n    delivery_rate: deliveryRate,\n    read_rate: readRate,\n    reply_rate: replyRate,\n    isWeeklyRun,\n    metricsRows,\n    rawRows\n  }\n}];"
