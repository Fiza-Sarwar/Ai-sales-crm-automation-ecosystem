      "parameters": {
        "jsCode": "const rows = $input.all().map(item => item.json);\n\n// --------------------\n// Filter to today's messages only\n// --------------------\nconst today = new Date().toISOString().split('T')[0]; // e.g. \"2026-08-07\"\n\nconst todayRows = rows.filter(row => {\n  const rawDate = row['sent_at'] || row['updated_at'] || '';\n  if (!rawDate || rawDate.toString().trim() === '') return false;\n  try {\n    const sentDate = new Date(rawDate).toISOString().split('T')[0];\n    return sentDate === today;\n  } catch(e) {\n    return false;\n  }\n});\n\n// --------------------\n// DEBUG: log how many rows matched (remove after testing)\n// --------------------\nconsole.log(`Total rows in sheet: ${rows.length}`);\nconsole.log(`Rows matching today (${today}): ${todayRows.length}`);\nif (rows.length > 0) {\n  console.log(`Sample sent_at value: \"${rows[0]['sent_at']}\"`);\n}\n\n// --------------------\n// Remove duplicate message_ids\n// --------------------\nconst uniqueMessages = new Map();\n\nfor (const row of todayRows) {\n  if (!row.message_id) continue;\n  const existing = uniqueMessages.get(row.message_id);\n  if (!existing) {\n    uniqueMessages.set(row.message_id, row);\n    continue;\n  }\n  if (new Date(row.updated_at || row.sent_at) > new Date(existing.updated_at || existing.sent_at)) {\n    uniqueMessages.set(row.message_id, row);\n  }\n}\n\nconst deduped = [...uniqueMessages.values()];\n\n// --------------------\n// Aggregate by Channel\n// --------------------\nconst summary = {};\n\nfor (const row of deduped) {\n  const channel = row.channel || 'Unknown';\n\n  if (!summary[channel]) {\n    summary[channel] = {\n      channel,\n      total_messages: 0,\n      sent: 0,\n      delivered: 0,\n      read: 0,\n      replied: 0,\n      failed: 0,\n      retry_count: 0\n    };\n  }\n\n  const s = summary[channel];\n  s.total_messages++;\n  s.sent++;\n\n  if (\n    row.delivery_status === 'Delivered' ||\n    row.read_status === 'TRUE' || row.read_status === true ||\n    row.reply_status === 'TRUE' || row.reply_status === true\n  ) {\n    s.delivered++;\n  }\n\n  if (row.read_status === 'TRUE' || row.read_status === true ||\n      row.reply_status === 'TRUE' || row.reply_status === true) {\n    s.read++;\n  }\n\n  if (row.reply_status === 'TRUE' || row.reply_status === true ||\n      row.messaging_status === 'Active Conversation') {\n    s.replied++;\n  }\n\n  if (row.delivery_status === 'Failed') {\n    s.failed++;\n  }\n\n  s.retry_count += Number(row.retry_count || 0);\n}\n\n// --------------------\n// Calculate Rates\n// --------------------\nconst metrics = Object.values(summary).map(r => ({\n  ...r,\n  delivery_rate: r.sent ? +(r.delivered / r.sent * 100).toFixed(1) : 0,\n  read_rate: r.delivered ? +(r.read / r.delivered * 100).toFixed(1) : 0,\n  reply_rate: r.read ? +(r.replied / r.read * 100).toFixed(1) : 0\n}));\n\n// If no data today, return a placeholder so downstream nodes don't crash\nif (metrics.length === 0) {\n  return [{\n    json: {\n      rawRows: [],\n      metrics: [],\n      noDataToday: true,\n      today\n    }\n  }];\n}\n\nreturn [{\n  json: {\n    rawRows: deduped,\n    metrics,\n    noDataToday: false,\n    today\n  }\n}];"
      },
