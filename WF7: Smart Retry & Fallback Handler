      "parameters": {
        "jsCode": "// Grab root items from $json if not nested under body\nconst body = $json.body || $json;\nconst query = $json.query || {};\nconst params = $json.params || {};\n\nlet out = {\n  message_id: body.messageId || query.message_id || params.id || null,\n  channel: body.channel || query.channel || 'Email',\n  status_type: body.type || query.status_type || 'delivery',\n  status_value: body.status || query.status_value || 'Delivered',\n  timestamp: new Date().toISOString(),\n  reply_text: body.replyText || query.reply_text || null,\n  params: params,\n  query: query\n};\n\n// Existing WhatsApp / Twilio / Gmail conditional checks follow below...\nif (body.entry) {\n  out.channel = 'WhatsApp';\n  const change = body.entry[0]?.changes?.[0]?.value;\n  if (change?.statuses) {\n    const s = change.statuses[0];\n    out.message_id = s.id;\n    out.status_type = 'delivery';\n    out.status_value = s.status === 'delivered' ? 'Delivered' : (s.status === 'read' ? 'Read' : s.status === 'failed' ? 'Failed' : s.status);\n    out.timestamp = new Date(parseInt(s.timestamp, 10) * 1000).toISOString();\n    if (s.status === 'read') out.status_type = 'read';\n  } else if (change?.messages) {\n    const m = change.messages[0];\n    out.message_id = m.context?.id || m.id;\n    out.status_type = 'reply';\n    out.status_value = 'Replied';\n    out.reply_text = m.text?.body || '';\n    out.timestamp = new Date(parseInt(m.timestamp, 10) * 1000).toISOString();\n  }\n} else if (body.SmsSid || body.MessageSid) {\n  out.channel = 'SMS';\n  out.message_id = body.MessageSid || body.SmsSid;\n  if (body.Body) {\n    out.status_type = 'reply';\n    out.status_value = 'Replied';\n    out.reply_text = body.Body;\n  } else {\n    out.status_type = 'delivery';\n    out.status_value = body.MessageStatus === 'delivered' ? 'Delivered' : body.MessageStatus === 'failed' ? 'Failed' : body.MessageStatus;\n  }\n} else if (body.messageId && body.channel === 'Email') {\n  out.channel = 'Email';\n  out.message_id = body.messageId;\n  out.status_type = body.type || 'delivery';\n  out.status_value = body.status || 'Delivered';\n  out.reply_text = body.replyText || null;\n}\n\n// Return in correct n8n format\nreturn [{ json: out }];"
