    {
      "parameters": {
        "jsCode": "// Retrieve all incoming call log items from Google Sheets\nconst logs = $input.all();\n\nlet callCount = logs.length;\nlet outcomes = {};\nlet internStats = {};\nlet notesSummary = [];\nlet uniqueEmails = new Set(); // Using a Set to collect only UNIQUE emails\n\nfor (let log of logs) {\n  const data = log.json;\n  \n  // Tally overall outcomes (Interested, Converted, etc.)\n  const outcome = data['Outcomes'] || 'Unknown';\n  outcomes[outcome] = (outcomes[outcome] || 0) + 1;\n  \n  // Tally intern metrics (who made how many calls)\n  const intern = data['Intern name'] || 'Unknown';\n  internStats[intern] = (internStats[intern] || 0) + 1;\n  \n  // Collect unique emails from the sheet\n  if (data['Email']) {\n    uniqueEmails.add(data['Email'].trim());\n  }\n  \n  // Collect clean, compressed notes\n  notesSummary.push(`- Intern: ${intern} | Company: ${data['Company name']} | Outcome: ${outcome} | Notes: ${data['Notes']}`);\n}\n\n// Format the final compressed object to send to Gemini\nconst compressedData = {\n  total_calls_logged: callCount,\n  outcome_distribution: outcomes,\n  intern_call_volume: internStats,\n  individual_call_telemetry: notesSummary.join(\"\\n\"),\n  intern_email_list: Array.from(uniqueEmails).join(\", \") // Converts set back to a clean list of emails separated by commas\n};\n\nreturn [{ json: compressedData }];"
      },
