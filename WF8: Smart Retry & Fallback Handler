      "parameters": {
        "jsCode": "\n// Build a config map from the Configuration Module rows.\nconst configRows = $('Read Configuration').all();\nconst cfg = {};\nfor (const r of configRows) {\n  const key = (r.json.config_key || '').toString().trim();\n  if (key) cfg[key] = r.json;\n}\n\nconst parseList = (v) =>\n  (v || '')\n    .toString()\n    .split(',')\n    .map((s) => s.trim())\n    .filter((s) => s.length > 0);\n\nconst maxRetries = parseInt((cfg['max_retries'] && cfg['max_retries'].config_value) || '2', 10) || 2;\nconst backoff = parseList(cfg['retry_backoff_minutes'] && cfg['retry_backoff_minutes'].config_value)\n  .map((n) => parseInt(n, 10))\n  .filter((n) => !isNaN(n));\nconst backoffSchedule = backoff.length ? backoff : [5, 30];\n// channel_priority may live in config_value or the dedicated channel_priority column.\nconst cpRow = cfg['channel_priority'] || {};\nconst channelPriority = parseList(cpRow.config_value || cpRow.channel_priority);\nconst priority = channelPriority.length ? channelPriority : ['WhatsApp', 'SMS', 'Email'];\n\nconst out = [];\nfor (const item of $input.all()) {\n  const row = item.json;\n  const currentChannel = (row.channel || priority[0]).toString().trim();\n  const retryCount = parseInt(row.retry_count, 10) || 0;\n  let idx = priority.indexOf(currentChannel);\n  if (idx === -1) idx = 0;\n\n  let decision, nextChannel, nextRetryCount, backoffMinutes, newMessagingStatus, newDeliveryStatus;\n\n  if (retryCount < maxRetries) {\n    // Same-channel retry with backoff.\n    decision = 'retry_same_channel';\n    nextChannel = currentChannel;\n    nextRetryCount = retryCount + 1;\n    backoffMinutes = backoffSchedule[retryCount] != null\n      ? backoffSchedule[retryCount]\n      : backoffSchedule[backoffSchedule.length - 1];\n    newMessagingStatus = 'Retrying';\n    newDeliveryStatus = 'Pending';\n  } else if (idx < priority.length - 1) {\n    // Exhausted on current channel; advance to next channel and reset counter.\n    decision = 'fallback_channel';\n    nextChannel = priority[idx + 1];\n    nextRetryCount = 0;\n    backoffMinutes = 0;\n    newMessagingStatus = 'Retrying';\n    newDeliveryStatus = 'Pending';\n  } else {\n    // All channels exhausted.\n    decision = 'communication_failed';\n    nextChannel = currentChannel;\n    nextRetryCount = retryCount;\n    backoffMinutes = 0;\n    newMessagingStatus = 'Communication Failed';\n    newDeliveryStatus = 'Failed';\n  }\n\n  out.push({\n    json: {\n      message_id: row.message_id,\n      lead_id: row.lead_id,\n      message_number: row.message_number,\n      template_id: row.template_id,\n      channel: currentChannel,\n      next_channel: nextChannel,\n      retry_count: retryCount,\n      next_retry_count: nextRetryCount,\n      backoff_minutes: backoffMinutes,\n      decision,\n      new_messaging_status: newMessagingStatus,\n      new_delivery_status: newDeliveryStatus,\n      manual_review_required: decision === 'communication_failed',\n      max_retries: maxRetries,\n      channel_priority: priority.join(', '),\n      attempt_logged_at: new Date().toISOString(),\n    },\n  });\n}\n\nreturn out;\n"
      },
